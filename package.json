{
  "config": {
    "supabaseCliVersion": "2.106.0",
    "supabaseProjectRefDev": "fotofiyqnuyvgtotswie",
    "supabaseProjectRefMain": "qgzvkongdjqiiamzbbts"
  },
  "scripts": {
    "prestart": "[ -x node_modules/.bin/supabase ] && node_modules/.bin/supabase --version >/dev/null 2>&1 || npm rebuild supabase --foreground-scripts || true",
    "start": "node_modules/.bin/supabase functions serve --env-file ./supabase/.env.local --no-verify-jwt",
    "check": "node ./scripts/deno-check-all.cjs",
    "deploy:dev": "node ./scripts/deploy-function.cjs dev",
    "deploy:main": "node ./scripts/deploy-function.cjs main",
    "probe:auth": "node ./scripts/probe-functions-auth.cjs",
    "test:worker-contract:unit": "deno test --allow-env --config supabase/functions/deno.json test/worker_jobs_test.ts test/app_worker_jobs_test.ts test/worker_jobs_cutover_test.ts",
    "test:worker-contract:consumer-zero": "deno test --allow-read=supabase/functions --config supabase/functions/deno.json test/worker_rpc_consumer_zero_test.ts",
    "test:lca-result-family:consumer-zero": "node --test test/lca_result_family_consumer_zero_test.cjs && node scripts/lca-result-family-consumer-zero.cjs",
    "test:worker-contract:db": "node ./scripts/run-worker-capability-contract.cjs local",
    "test:worker-contract:hosted": "node ./scripts/run-worker-capability-contract.cjs hosted-preview",
    "diagnose:lca-snapshot:call-sites": "node ./scripts/diagnose-lca-snapshot-callsite-inventory.cjs",
    "test:lca-snapshot:db": "node ./scripts/run-lca-snapshot-capability-contract.cjs",
    "test:lca-result-family:unit": "deno test --allow-env --config supabase/functions/deno.json test/lca_result_family_capability_test.ts test/lca_result_family_handler_test.ts test/lca_query_result_family_handler_test.ts test/lca_solve_cache_state_test.ts test/lca_contribution_cache_state_test.ts test/lca_all_unit_solve_queue_test.ts test/lca_result_contract_cleanup_test.ts",
    "test:lca-result-family:consumer-zero": "node --test test/lca_result_family_consumer_zero_test.cjs && node scripts/lca-result-family-consumer-zero.cjs && deno test --allow-read=supabase/functions --config supabase/functions/deno.json test/lca_result_family_consumer_zero_test.ts",
    "test:lca-result-family:db": "node ./scripts/run-lca-result-family-contract.cjs",
    "format": "prettier --write \"**/*.{cjs,js,jsx,tsx,ts,less,md,json,yml,yaml}\"",
    "lint": "prettier --check \"**/*.{cjs,js,jsx,tsx,ts,less,md,json,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "supabase": "2.106.0",
    "typescript": "^5.9.3"
  }
}
