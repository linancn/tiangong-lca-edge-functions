{
  "config": {
    "denoVersion": "2.9.5",
    "denoTypeScriptVersion": "6.0.3",
    "supabaseCliVersion": "2.106.0",
    "supabaseProjectRefDev": "submidrhbtknjxfympna",
    "supabaseProjectRefMain": "qgzvkongdjqiiamzbbts"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "start": "pnpm exec supabase functions serve --env-file ./supabase/.env.local --no-verify-jwt",
    "check:env": "node scripts/check-env.cjs",
    "check:types": "node scripts/deno-check-all.cjs",
    "test:node": "node --test scripts/*.test.cjs",
    "test:deno": "deno test --config supabase/functions/deno.json --allow-env --allow-read --allow-net=127.0.0.1 test",
    "test": "pnpm test:node && pnpm test:deno",
    "check": "pnpm check:env && pnpm check:types && pnpm test",
    "deploy:dev": "node ./scripts/deploy-function.cjs dev",
    "deploy:main": "node ./scripts/deploy-function.cjs main",
    "probe:auth": "node ./scripts/probe-functions-auth.cjs",
    "format": "pnpm exec prettier --write \"**/*.{cjs,js,jsx,tsx,ts,less,md,json,yml,yaml}\"",
    "lint": "pnpm exec prettier --check \"**/*.{cjs,js,jsx,tsx,ts,less,md,json,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "supabase": "2.106.0"
  }
}
