          "description": "Dictionary-like aliases in English only. No intent/topic phrases.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fulltext_query_zh": {
          "title": "FulltextQueryZH",
          "description": "Dictionary-like aliases in Simplified Chinese only. No intent/topic phrases.",
