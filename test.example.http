# Edge #357 dependency review: the latest runtime import graph changes no endpoint,
# authentication header, request payload, or response example in this collection.
# Hybrid Search v2 accepts one lexical_weight and one semantic_weight.
# Do not restore the retired full_text_weight or extracted_text_weight fields.
### @name Flow_Hybrid_Search：Remote

curl -i --location --request POST '{{$dotenv REMOTE_ENDPOINT}}/flow_hybrid_search' \
    --header 'Content-Type: application/json' \
    --header 'x-region: {{$dotenv X_REGION}}' \
    --header 'Authorization: Bearer {{$dotenv USER_API_KEY}}' \
    --data '{"query": "氯氰菊酯", "lexical_weight": 0.5, "semantic_weight": 0.5}'

### @name Flow_Hybrid_Search：Local

curl -i --location --request POST '{{$dotenv LOCAL_ENDPOINT}}/flow_hybrid_search' \
    --header 'Content-Type: application/json' \
    --header 'Authorization: Bearer {{$dotenv USER_API_KEY}}' \
    --data '{"query": "氯氰菊酯", "lexical_weight": 0.5, "semantic_weight": 0.5}'

