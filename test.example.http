### `lca_query_results` resolves the persisted v1/v2 query-artifact format automatically.
### These request bodies are identical for historical inline and current chunked results.
### @name LCA_Query_Results：Local (single process -> all impacts)
curl -i --location --request POST '{{$dotenv LOCAL_ENDPOINT}}/lca_query_results' \
    --header 'Content-Type: application/json' \
    --header 'Authorization: Bearer {{$dotenv USER_JWT}}' \
    --data '{
      "scope": "prod",
      "data_scope": "current_user",
      "mode": "process_all_impacts",
      "process_id": "{{$dotenv LCA_PROCESS_ID}}"
    }'

### @name LCA_Query_Results：Local (multi process -> one impact)
curl -i --location --request POST '{{$dotenv LOCAL_ENDPOINT}}/lca_query_results' \
    --header 'Content-Type: application/json' \
    --header 'Authorization: Bearer {{$dotenv USER_JWT}}' \
    --data '{
      "scope": "prod",
      "data_scope": "current_user",
      "mode": "processes_one_impact",
      "process_ids": ["{{$dotenv LCA_PROCESS_ID}}"],
      "impact_id": "{{$dotenv LCA_IMPACT_ID}}"
    }'

### @name LCA_Query_Results：Local (snapshot hotspot ranking -> one impact)
curl -i --location --request POST '{{$dotenv LOCAL_ENDPOINT}}/lca_query_results' \
    --header 'Content-Type: application/json' \
    --header 'Authorization: Bearer {{$dotenv USER_JWT}}' \
    --data '{
      "scope": "prod",
      "data_scope": "all_data",
      "mode": "processes_one_impact",
      "impact_id": "{{$dotenv LCA_IMPACT_ID}}",
      "top_n": 20,
      "sort_by": "absolute_value",
      "sort_direction": "desc"
    }'

### @name LCA_Contribution_Path：Local
curl -i --location --request POST '{{$dotenv LOCAL_ENDPOINT}}/lca_contribution_path' \
    --header 'Content-Type: application/json' \
    --header 'Authorization: Bearer {{$dotenv USER_JWT}}' \
    --header 'X-Idempotency-Key: local-debug-path-001' \
    --data '{
      "scope": "prod",
      "data_scope": "current_user",
      "process_id": "{{$dotenv LCA_PROCESS_ID}}",
      "impact_id": "{{$dotenv LCA_IMPACT_ID}}",
      "amount": 1.0,
      "options": {
        "max_depth": 4,
        "top_k_children": 5,
        "cutoff_share": 0.01,
        "max_nodes": 200
      }
    }'

### @name LCA_Contribution_Path_Result：Local (query param)
curl -i --location --request GET '{{$dotenv LOCAL_ENDPOINT}}/lca_contribution_path_result?result_id={{$dotenv LCA_RESULT_ID}}' \
    --header 'Authorization: Bearer {{$dotenv USER_JWT}}'

### @name LCA_Contribution_Path_Result：Local (POST)
curl -i --location --request POST '{{$dotenv LOCAL_ENDPOINT}}/lca_contribution_path_result' \
    --header 'Content-Type: application/json' \
    --header 'Authorization: Bearer {{$dotenv USER_JWT}}' \
    --data '{
      "result_id": "{{$dotenv LCA_RESULT_ID}}"
    }'

### @name LCA_Release_Current：Local (public)
# Artifact upload retries reuse only the server-derived content-addressed object identity;
# finalize always re-downloads and validates the exact size and SHA-256 after any retry.
curl -i --location --request GET '{{$dotenv LOCAL_ENDPOINT}}/lca_release_results?mode=current'

### @name LCA_Release_Current：Local (Supabase browser-style public request)
# A matching project publishable/legacy anon key is a public project credential, not actor auth.
curl -i --location --request GET '{{$dotenv LOCAL_ENDPOINT}}/lca_release_results?mode=current' \
    --header 'apikey: {{$dotenv SUPABASE_PUBLISHABLE_KEY}}' \
    --header 'Authorization: Bearer {{$dotenv SUPABASE_PUBLISHABLE_KEY}}'

### @name LCA_Release_Artifact_Download：Local (public)
# Response includes a server-derived downloadFilename and a 15-minute signedDownloadUrl whose
# Content-Disposition uses the same semantic name instead of the content-addressed object key.
curl -i --location --request GET '{{$dotenv LOCAL_ENDPOINT}}/lca_release_results?mode=artifact_download&artifactId={{$dotenv LCA_RELEASE_ARTIFACT_ID}}'

### @name LCA_Release_Calculation_Bundle：Local (data_product_manager JWT)
# Response accepts a durable v1 or v2 bundle only when the private manifest has the exact same
# schema and verified integrity bindings, then includes 15-minute signedDownloadUrl values for the
# manifest, preview shards, and the role-bound LCIA XLSX/CSV, LCI Parquet/CSV, and audit ZIP;
# raw worker object URLs are not browser download contracts.
curl -i --location --request POST '{{$dotenv LOCAL_ENDPOINT}}/app_lca_release_commands' \
    --header 'Content-Type: application/json' \
    --header 'Authorization: Bearer {{$dotenv USER_JWT}}' \
    --data '{
      "action": "get_calculation_bundle",
      "packageId": "{{$dotenv LCA_RESULT_PACKAGE_ID}}"
    }'

### @name LCA_Release_Run：Local (data_product_manager JWT)
curl -i --location --request POST '{{$dotenv LOCAL_ENDPOINT}}/app_lca_release_commands' \
    --header 'Content-Type: application/json' \
    --header 'Authorization: Bearer {{$dotenv USER_JWT}}' \
    --data '{
      "action": "get_release",
      "releaseRunId": "{{$dotenv LCA_RELEASE_RUN_ID}}"
    }'
