{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edge.schema-boundary-consumers.v1.schema",
  "title": "Edge schema-boundary consumer manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "canonicalization",
    "edgeBaseCommit",
    "sourceAudit",
    "databaseSource",
    "policy",
    "apiCapabilities",
    "relationOccurrenceScope",
    "publicResidue",
    "dynamicConsumers",
    "platformConsumers",
    "relationOccurrences",
    "preferredApiIdentities"
  ],
  "properties": {
    "schemaVersion": { "const": "edge.schema-boundary-consumers.v1" },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sidecar", "schemaPath", "schemaSha256"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "sidecar": { "type": "string", "minLength": 1 },
        "schemaPath": { "type": "string", "minLength": 1 },
        "schemaSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "edgeBaseCommit": { "$ref": "#/$defs/commit" },
    "sourceAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "controls"],
      "properties": {
        "version": { "const": "typescript-supabase-dataflow.v2" },
        "controls": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "supabase-client-alias-chain",
              "static-computed-property-folding",
              "unknown-computed-property-fail-closed",
              "destructuring-and-detachment-rejection",
              "assignment-propagation",
              "local-parameter-propagation",
              "local-return-propagation"
            ]
          }
        }
      }
    },
    "databaseSource": {
      "type": "object",
      "required": [
        "issue",
        "candidateComment",
        "repository",
        "freezeSchemaVersion",
        "freezeSchemaPath",
        "baseCommit",
        "migrationHead",
        "publicObjectInventorySha256",
        "state",
        "authorization",
        "authorizedSlices",
        "frozenManifest",
        "requiredFrozenBindings"
      ],
      "properties": {
        "issue": { "const": "tiangong-lca/database-engine#357" },
        "candidateComment": { "const": 5155276316 },
        "repository": { "const": "tiangong-lca/database-engine" },
        "freezeSchemaVersion": { "const": "database.lca-private-expand-freeze.v3" },
        "freezeSchemaPath": { "type": "string", "minLength": 1 },
        "baseCommit": { "const": "2ca8ea3243f67f878533e1a46df0747987ad9b5f" },
        "migrationHead": { "const": "20260802022552" },
        "publicObjectInventorySha256": { "$ref": "#/$defs/sha256" },
        "state": { "enum": ["candidate-not-frozen", "reviewed-frozen"] },
        "authorization": {
          "enum": ["not-authorized", "consumer-migration-authorized"]
        },
        "authorizedSlices": {
          "const": [
            {
              "sliceId": "e3-b-save-draft-api-v1",
              "issue": "tiangong-lca/database-engine#372",
              "mergeCommit": "2ca8ea3243f67f878533e1a46df0747987ad9b5f",
              "migrationHead": "20260802022552",
              "migrationPath": "supabase/migrations/20260802022552_issue_372_edge_worker_expand_slice.sql",
              "migrationSha256": "026b895768221644a1b9915c2685d993bc74e0122ed64808dda92a95e1d176a3",
              "validationComment": 5155369682,
              "state": "persistent-dev-verified",
              "authorization": "consumer-migration-authorized",
              "apiActorRoutines": ["cmd_dataset_save_draft"],
              "apiServiceRoutines": [],
              "sourceMd5": "b620aa117cebe7f6e01ed5c4acfe86d6",
              "executeRoles": ["authenticated", "service_role"],
              "deniedRoles": ["PUBLIC", "anon"]
            }
          ]
        },
        "frozenManifest": { "type": "object" },
        "requiredFrozenBindings": { "type": "object" }
      }
    },
    "policy": {
      "type": "object",
      "required": ["retainedPublicTables", "allowedPostgrestSchemas"],
      "properties": {
        "retainedPublicTables": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "allowedPostgrestSchemas": {
          "const": ["api"]
        }
      }
    },
    "apiCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relations", "actorRoutines", "serviceRoutines"],
      "properties": {
        "relations": { "$ref": "#/$defs/threeUniqueStrings" },
        "actorRoutines": {
          "const": ["cmd_dataset_save_draft"]
        },
        "serviceRoutines": {
          "const": []
        }
      }
    },
    "relationOccurrenceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "relations"],
      "properties": {
        "sourceKind": { "const": "typescript-ast-resolved-from-call" },
        "relations": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "publicResidue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relations", "routines", "dynamicRpcFiles"],
      "properties": {
        "relations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "routines": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "dynamicRpcFiles": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "dynamicConsumers": { "type": "array", "items": { "type": "object" } },
    "platformConsumers": { "type": "object" },
    "relationOccurrences": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": { "$ref": "#/$defs/relationOccurrence" }
    },
    "preferredApiIdentities": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": { "$ref": "#/$defs/preferredExposure" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "threeUniqueStrings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "relationOccurrence": {
      "type": "object",
      "required": [
        "file",
        "line",
        "relation",
        "operation",
        "span",
        "fields",
        "filters",
        "order",
        "limit",
        "ownership",
        "atomicityGroup",
        "idempotencyCas"
      ],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "relation": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["select", "insert", "update", "upsert", "delete"] },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 1 }
          }
        },
        "fields": {},
        "filters": {},
        "order": {},
        "limit": {},
        "ownership": {},
        "atomicityGroup": {},
        "idempotencyCas": {}
      }
    },
    "preferredExposure": {
      "type": "object",
      "required": ["capability", "identity", "returns", "signature", "acl"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "identity": { "type": "string", "pattern": "^api\\." },
        "returns": { "type": "string", "minLength": 1 },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identityArguments", "arguments", "resultType"],
          "properties": {
            "identityArguments": {
              "type": "array",
              "items": { "type": "string" }
            },
            "arguments": {
              "type": "array",
              "items": { "type": "string" }
            },
            "resultType": { "type": "string", "minLength": 1 }
          }
        },
        "acl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "authorizationPolicyIds", "executeRoles", "deniedRoles"],
          "properties": {
            "state": { "enum": ["candidate-not-frozen", "reviewed-frozen"] },
            "authorizationPolicyIds": {
              "type": ["array", "null"],
              "items": { "type": "string" }
            },
            "executeRoles": {
              "type": ["array", "null"],
              "items": { "type": "string" }
            },
            "deniedRoles": {
              "type": ["array", "null"],
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
