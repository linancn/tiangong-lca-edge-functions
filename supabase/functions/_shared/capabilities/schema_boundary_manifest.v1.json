  "capabilityRequirements": {
    "resultCache": {
      "readAndTouch": {
        "inputs": ["scope", "snapshot_id", "request_key", "accessed_at"],
        "returns": ["id", "status", "job_id", "worker_job_id", "result_id", "hit_count"],
        "atomicity": "row read and hit_count=hit_count+1 in one transaction"
      },
      "putPending": {
        "inputs": [
          "scope",
          "snapshot_id",
          "request_key",
          "request_payload",
          "job_id",
          "worker_job_id",
          "accessed_at",
          "expected_existing_id",
          "expected_existing_status"
        ],
        "returns": ["id", "status", "job_id", "worker_job_id", "result_id", "hit_count"],
        "statusSet": ["pending"],
        "atomicity": "unique(scope,snapshot_id,request_key), insert-on-conflict plus CAS"
      },
      "transition": {
        "inputs": ["id", "expected_statuses", "patch"],
        "patchFields": [
          "status",
          "result_id",
          "job_id",
          "worker_job_id",
          "last_accessed_at",
          "updated_at"
        ],
        "statusSet": ["pending", "running", "completed", "failed"],
        "atomicity": "reviewed patch allowlist and fail-closed CAS"
      }
    },
    "tidasRequestCache": {
      "readAndTouch": {
        "inputs": [
          "p_requested_by uuid",
          "p_lookup_kind text",
          "p_lookup_value text",
          "p_accessed_at timestamptz"
        ],
        "lookupKinds": ["request_key", "job_id", "worker_job_id"],
        "lookupTypeRule": "lookup_value is text; request_key compares as text and job_id/worker_job_id use a fail-closed UUID safe cast selected by lookup_kind",
        "returns": [
          "id",
          "status",
          "request_key",
          "job_id",
          "worker_job_id",
          "error_code",
          "error_message",
          "hit_count",
          "last_accessed_at",
          "created_at",
          "updated_at",
          "export_artifact_id",
          "report_artifact_id"
        ],
        "ownership": "requested_by = authenticated actor",
        "atomicity": "read plus hit_count increment"
      },
      "putPending": {
        "inputs": [
          "requested_by",
          "request_key",
          "request_payload",
          "job_id",
          "worker_job_id",
          "accessed_at",
          "expected_existing_id",
          "expected_existing_status"
        ],
        "returns": [
          "id",
          "status",
          "job_id",
          "worker_job_id",
          "export_artifact_id",
          "report_artifact_id",
          "hit_count"
        ],
        "atomicity": "unique(requested_by,operation='export_package',request_key) plus CAS; reset artifact/error fields"
      }
    },
    "tidasArtifact": {
      "prepareImportSource": {
        "inputs": [
          "requested_by",
          "idempotency_key",
          "artifact_url",
          "content_type",
          "metadata",
          "expires_at",
          "now"
        ],
        "returns": ["id", "job_id", "worker_job_id", "status", "artifact_url", "metadata"],
        "generatedByDatabase": ["id", "job_id"],
        "atomicity": "reuse or create pending by (requested_by,idempotency_key)"
      },
      "markImportSourceReady": {
        "inputs": [
          "id",
          "job_id",
          "expected_status=pending",
          "sha256",
          "byte_size",
          "content_type",
          "metadata_patch",
          "now"
        ],
        "metadataMerge": {
          "preserve": ["requested_by", "import_prepare_idempotency_key", "object_path"],
          "overwrite": ["filename", "original_filename", "upload_state"]
        },
        "atomicity": "CAS pending to ready after external upload"
      },
      "linkWorker": {
        "inputs": [
          "id",
          "job_id",
          "expected_worker_job_id=null",
          "worker_job_id",
          "metadata_patch",
          "now"
        ],
        "metadataMerge": {
          "preserve": [
            "requested_by",
            "import_prepare_idempotency_key",
            "object_path",
            "filename",
            "original_filename",
            "upload_state"
          ],
          "overwrite": ["worker_job_id"]
        },
        "atomicity": "CAS link, never overwrite an existing worker binding"
      },
      "reads": {
        "returns": [
          "id",
          "job_id",
          "worker_job_id",
          "artifact_kind",
          "status",
          "artifact_url",
          "artifact_sha256",
          "artifact_byte_size",
          "artifact_format",
          "content_type",
          "metadata",
          "expires_at",
          "is_pinned",
          "created_at",
          "updated_at"
        ],
        "ownership": "service-only caller supplies p_requested_by from the already authenticated Edge actor; the same SQL statement must join/exists-check lca_package_request_cache.requested_by before returning an artifact"
      }
    },
    "snapshot": {
      "requirements": [
        "resolve active by exact scope",
        "resolve latest/explicit ready artifact",
        "bounded candidate network query is discovery only; Edge must continue exact process_filter comparison and contains must never be treated as authorization",
        "idempotent full_library draft create with created_by actor binding",
        "latest-all-unit and worker-result projections"
      ]
    },
    "publicationPackage": {
      "requirements": [
        "current public publication and its required preview_ready package are returned from one SQL statement/snapshot as one envelope",
        "bounded admin publication list ordered current/published/created desc includes its package projections in the same SQL envelope",
        "packages by bounded ids",
        "packages by bounded worker-job ids",
        "package by id and required status"
      ]
    }
  },
