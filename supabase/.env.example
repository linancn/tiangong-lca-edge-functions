# Supabase project used by functions for auth validation and privileged RPC/database calls.
# Keep these three values from the same Supabase project.
REMOTE_SUPABASE_URL=
REMOTE_SUPABASE_PUBLISHABLE_KEY=
REMOTE_SUPABASE_SECRET_KEY=

# Custom function-level service API key for routes that allow AuthMethod.SERVICE_API_KEY.
# This is not a Supabase client key.
REMOTE_SERVICE_API_KEY=

# Disposable Portal R0 EdgeOne/Supabase interoperability fixture. Every value is isolated from
# the long-lived Portal Dev/Main surfaces below. Hosted evidence uses target=preview, an isolated
# Supabase Preview/test project, one-time HMAC/publishable credentials, and a one-time Redis
# database/namespace. Remove the remote function, credentials, and Redis resource after evidence.
PORTAL_R0_RUNTIME_TARGET=test
PORTAL_R0_HMAC_KEY_ID_CURRENT=
PORTAL_R0_HMAC_SECRET_CURRENT=
# Leave both optional previous values empty when no rotation is active. One empty side fails closed,
# and current/previous must use both different key IDs and different decoded secrets.
PORTAL_R0_HMAC_KEY_ID_PREVIOUS=
PORTAL_R0_HMAC_SECRET_PREVIOUS=
PORTAL_R0_SUPABASE_PUBLISHABLE_KEY=
PORTAL_R0_REDIS_CLIENT_TYPE=upstash
PORTAL_R0_UPSTASH_REDIS_URL=
PORTAL_R0_UPSTASH_REDIS_TOKEN=
PORTAL_R0_REDIS_URL=
# Empty means no Standard Redis password; whitespace-bearing values are invalid.
PORTAL_R0_REDIS_PASSWORD=
PORTAL_R0_REDIS_NAMESPACE=portal:r0:fixture-change-me:v1
PORTAL_R0_REDIS_TIMEOUT_MS=500
PORTAL_R0_MINUTE_BUDGET=4
PORTAL_R0_DAILY_BUDGET=20
PORTAL_R0_MAX_CONCURRENCY=2
PORTAL_R0_LEASE_TTL_SECONDS=20

# Portal-only HMAC verifier. Secrets are unpadded Base64URL with at least 32 decoded bytes.
# Preview/dev and production/main must use different current key ids and secrets. Configure the
# previous pair only during a bounded zero-downtime rotation window.
PORTAL_HMAC_KEY_ID_CURRENT=
PORTAL_HMAC_SECRET_CURRENT=
PORTAL_HMAC_KEY_ID_PREVIOUS=
PORTAL_HMAC_SECRET_PREVIOUS=

# Dedicated modern public credential for both signed Portal routes. The runtime verifies this key
# against the platform-owned SUPABASE_PUBLISHABLE_KEYS registry, uses platform-injected
# SUPABASE_URL, and never falls back to generic or REMOTE_* key/URL variables.
PORTAL_SUPABASE_PUBLISHABLE_KEY=

# Portal-only replay, route-budget, concurrency-lease, and public-result cache storage.
# These credentials are dedicated to Portal. Hosted dev/main use separate Upstash databases and
# tokens; local/CI may select a Portal-only standard Redis instead.
PORTAL_REDIS_CLIENT_TYPE=upstash
PORTAL_UPSTASH_REDIS_URL=
PORTAL_UPSTASH_REDIS_TOKEN=
PORTAL_REDIS_URL=
PORTAL_REDIS_PASSWORD=
PORTAL_REDIS_NAMESPACE=portal:dev:v1
PORTAL_REDIS_TIMEOUT_MS=500
PORTAL_LCIA_MINUTE_BUDGET=120
PORTAL_LCIA_DAILY_BUDGET=20000
PORTAL_LCIA_MAX_CONCURRENCY=20
PORTAL_LCIA_LEASE_TTL_SECONDS=30
PORTAL_LCIA_CACHE_TTL_SECONDS=60
PORTAL_LCIA_UPSTREAM_TIMEOUT_MS=8000

# R2 Portal Hybrid cost boundary. Exact lowercase `true` is required to enable the route; every
# other value, including an unset value, keeps it disabled before Redis/model/database work.
# These limits, lease, model cache, and circuit keys are independent from the R1 LCIA route.
PORTAL_HYBRID_ENABLED=false
PORTAL_HYBRID_MINUTE_BUDGET=60
PORTAL_HYBRID_DAILY_BUDGET=5000
PORTAL_HYBRID_MAX_CONCURRENCY=4
PORTAL_HYBRID_LEASE_TTL_SECONDS=30
PORTAL_HYBRID_CACHE_TTL_SECONDS=60
PORTAL_HYBRID_TIMEOUT_MS=6000
PORTAL_HYBRID_CIRCUIT_FAILURE_THRESHOLD=5
PORTAL_HYBRID_CIRCUIT_WINDOW_SECONDS=60
PORTAL_HYBRID_CIRCUIT_OPEN_SECONDS=60

# Portal-only R2 model providers. These values are resolved as one strict configuration after the
# exact-lowercase-true kill switch and are never filled from the generic provider variables below.
PORTAL_OPENAI_API_KEY=
PORTAL_OPENAI_CHAT_MODEL=
PORTAL_OPENAI_BASE_URL=
PORTAL_SAGEMAKER_ENDPOINT_NAME=
PORTAL_AWS_ACCESS_KEY_ID=
PORTAL_AWS_SECRET_ACCESS_KEY=
PORTAL_AWS_SESSION_TOKEN=

# Route-specific exact commit SHAs included only in allowlisted Portal security events.
PORTAL_LCIA_DEPLOYMENT_SHA=
PORTAL_HYBRID_DEPLOYMENT_SHA=

# Existing non-Portal OpenAI-backed structured output/chat helpers.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Existing non-Portal SageMaker endpoint used by login Hybrid and embedding_ft.
SAGEMAKER_ENDPOINT_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# TIDAS package and national-carbon graph cache storage.
S3_BUCKET=
S3_PREFIX=
S3_ENDPOINT=
# Optional private bucket override for the four immutable LCI/LCIA release ZIP artifacts.
# Defaults to S3_BUCKET, then lca_results. Never expose its service credential to release clients.
LCA_RELEASE_STORAGE_BUCKET=
NATIONAL_CARBON_GRAPH_CACHE_BUCKET=
NATIONAL_CARBON_GRAPH_CACHE_PREFIX=
NATIONAL_CARBON_GRAPH_CACHE_SIGNED_URL_EXPIRES_IN=3600

# Worker-job cutover gates. Leave true unless deliberately testing fail-closed legacy paths.
WORKER_JOBS_CUTOVER_ENABLED=true

# embedding_ft database-update backoff.
EMBEDDING_FT_DB_LOCK_TIMEOUT=5s
EMBEDDING_FT_DB_STATEMENT_TIMEOUT=30s
EMBEDDING_FT_DB_RETRY_BACKOFF_SECONDS=300
