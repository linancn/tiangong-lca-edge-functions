# Supabase project used by functions for auth validation and privileged RPC/database calls.
# Keep these three values from the same Supabase project.
REMOTE_SUPABASE_URL=
REMOTE_SUPABASE_PUBLISHABLE_KEY=
REMOTE_SUPABASE_SECRET_KEY=

# Custom function-level service API key for routes that allow AuthMethod.SERVICE_API_KEY.
# This is not a Supabase client key.
REMOTE_SERVICE_API_KEY=

# User API key authentication cache.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Portal-only HMAC verifier. Secrets are unpadded Base64URL with at least 32 decoded bytes.
# Preview/dev and production/main must use different current key ids and secrets. Configure the
# previous pair only during a bounded zero-downtime rotation window.
PORTAL_HMAC_KEY_ID_CURRENT=
PORTAL_HMAC_SECRET_CURRENT=
PORTAL_HMAC_KEY_ID_PREVIOUS=
PORTAL_HMAC_SECRET_PREVIOUS=

# Portal replay, route-budget, concurrency-lease, and public-result cache storage.
# Hosted dev/main use separate Upstash databases and tokens with separate namespaces. Local/CI
# may set REDIS_CLIENT_TYPE=standard with REDIS_URL and optional REDIS_PASSWORD instead.
REDIS_CLIENT_TYPE=upstash
REDIS_URL=
REDIS_PASSWORD=
PORTAL_REDIS_NAMESPACE=portal:dev:v1
PORTAL_REDIS_TIMEOUT_MS=500
PORTAL_LCIA_MINUTE_BUDGET=120
PORTAL_LCIA_DAILY_BUDGET=20000
PORTAL_LCIA_MAX_CONCURRENCY=20
PORTAL_LCIA_LEASE_TTL_SECONDS=30
PORTAL_LCIA_CACHE_TTL_SECONDS=60
PORTAL_LCIA_UPSTREAM_TIMEOUT_MS=8000

# R2 Portal Hybrid cost boundary. Exact lowercase `true` is required to enable the route; every
# other value, including an unset value, keeps it disabled before Redis/model/database work.
# These limits, lease, model cache, and circuit keys are independent from the R1 LCIA route.
PORTAL_HYBRID_ENABLED=false
PORTAL_HYBRID_MINUTE_BUDGET=60
PORTAL_HYBRID_DAILY_BUDGET=5000
PORTAL_HYBRID_MAX_CONCURRENCY=4
PORTAL_HYBRID_LEASE_TTL_SECONDS=30
PORTAL_HYBRID_CACHE_TTL_SECONDS=60
PORTAL_HYBRID_TIMEOUT_MS=8000
PORTAL_HYBRID_CIRCUIT_FAILURE_THRESHOLD=5
PORTAL_HYBRID_CIRCUIT_WINDOW_SECONDS=60
PORTAL_HYBRID_CIRCUIT_OPEN_SECONDS=60
# Public exact commit SHA included only in allowlisted Portal security events.
PORTAL_DEPLOYMENT_SHA=

# OpenAI-backed structured output/chat helpers.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# SageMaker embedding endpoint used by hybrid search and embedding_ft.
SAGEMAKER_ENDPOINT_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Cognito-backed account functions.
COGNITO_USER_POOL_ID=

# TIDAS package and national-carbon graph cache storage.
S3_BUCKET=
S3_PREFIX=
S3_ENDPOINT=
# Optional private bucket override for the four immutable LCI/LCIA release ZIP artifacts.
# Defaults to S3_BUCKET, then lca_results. Never expose its service credential to release clients.
LCA_RELEASE_STORAGE_BUCKET=
NATIONAL_CARBON_GRAPH_CACHE_BUCKET=
NATIONAL_CARBON_GRAPH_CACHE_PREFIX=
NATIONAL_CARBON_GRAPH_CACHE_SIGNED_URL_EXPIRES_IN=3600

# Worker-job cutover gates. Leave true unless deliberately testing fail-closed legacy paths.
WORKER_JOBS_CUTOVER_ENABLED=true

# embedding_ft database-update backoff.
EMBEDDING_FT_DB_LOCK_TIMEOUT=5s
EMBEDDING_FT_DB_STATEMENT_TIMEOUT=30s
EMBEDDING_FT_DB_RETRY_BACKOFF_SECONDS=300
